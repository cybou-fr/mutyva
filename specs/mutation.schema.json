{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutyva.invalid/specs/mutation.schema.json",
  "title": "MUTYVA MVP mutation proposal",
  "type": "object",
  "required": [
    "schemaVersion",
    "appId",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "appId": {
      "type": "string",
      "minLength": 3
    },
    "intent": {
      "type": "string",
      "maxLength": 600
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "op",
              "widget"
            ],
            "properties": {
              "op": {
                "const": "addWidget"
              },
              "widget": {
                "$ref": "app.schema.json#/$defs/widget"
              },
              "after": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "id"
            ],
            "properties": {
              "op": {
                "const": "removeWidget"
              },
              "id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "id",
              "path",
              "value"
            ],
            "properties": {
              "op": {
                "const": "updateProperty"
              },
              "id": {
                "type": "string"
              },
              "path": {
                "enum": [
                  "title",
                  "text",
                  "value",
                  "placeholder",
                  "items",
                  "action",
                  "defaultCity"
                ]
              },
              "value": {}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "id",
              "after"
            ],
            "properties": {
              "op": {
                "const": "moveWidget"
              },
              "id": {
                "type": "string"
              },
              "after": {
                "type": "string"
              },
              "parent": {
                "type": "string",
                "maxLength": 64
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
