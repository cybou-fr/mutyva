{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutyva.invalid/specs/app.schema.json",
  "title": "MUTYVA MVP application definition",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "widgets",
    "dataSources",
    "permissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{3,128}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "widgets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/widget"
      }
    },
    "dataSources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "models": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "widget": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{1,63}$"
        },
        "kind": {
          "enum": [
            "city-search",
            "weather-card",
            "forecast-list",
            "air-card",
            "humidity-card",
            "text",
            "card",
            "stack",
            "row",
            "button",
            "input",
            "list",
            "record-form",
            "record-list",
            "checkbox",
            "select",
            "date-picker",
            "dialog",
            "tabs",
            "image",
            "icon"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "parent": {
          "type": "string",
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "value": {
          "type": "string",
          "maxLength": 500
        },
        "placeholder": {
          "type": "string",
          "maxLength": 120
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "input",
                "target"
              ],
              "properties": {
                "kind": {
                  "const": "append-item"
                },
                "input": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 64
                },
                "target": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 64
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "target"
              ],
              "properties": {
                "kind": {
                  "const": "clear-list"
                },
                "target": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 64
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "defaultCity": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{1,63}$"
        },
        "filter": {
          "type": "object",
          "required": [
            "field",
            "op",
            "value"
          ],
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{1,63}$"
            },
            "op": {
              "enum": [
                "equals",
                "before",
                "after"
              ]
            },
            "value": {}
          },
          "additionalProperties": false
        },
        "sort": {
          "type": "object",
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{1,63}$"
            },
            "descending": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "source": {
          "enum": [
            "mutyva-logo",
            "mutyva-icon",
            "mutyva-symbol"
          ]
        },
        "icon": {
          "enum": [
            "check",
            "star",
            "heart",
            "info",
            "warning",
            "folder",
            "calendar"
          ]
        },
        "style": {
          "type": "object",
          "properties": {
            "tone": {
              "enum": [
                "neutral",
                "accent",
                "danger"
              ]
            },
            "padding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "provider"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "enum": [
            "rest"
          ]
        },
        "provider": {
          "enum": [
            "open-meteo"
          ]
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "title",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{1,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{1,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "enum": [
            "text",
            "integer",
            "boolean",
            "date"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {}
      },
      "additionalProperties": false
    }
  }
}
