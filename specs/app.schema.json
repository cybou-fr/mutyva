{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutyva.invalid/specs/app.schema.json",
  "title": "MUTYVA MVP application definition",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "widgets",
    "dataSources",
    "permissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{3,128}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "widgets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/widget"
      }
    },
    "dataSources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "widget": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{1,63}$"
        },
        "kind": {
          "enum": [
            "city-search",
            "weather-card",
            "forecast-list",
            "air-card",
            "humidity-card",
            "text",
            "card",
            "stack",
            "row",
            "button",
            "input",
            "list"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "parent": {
          "type": "string",
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "value": {
          "type": "string",
          "maxLength": 500
        },
        "placeholder": {
          "type": "string",
          "maxLength": 120
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "input",
                "target"
              ],
              "properties": {
                "kind": {
                  "const": "append-item"
                },
                "input": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 64
                },
                "target": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 64
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "target"
              ],
              "properties": {
                "kind": {
                  "const": "clear-list"
                },
                "target": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 64
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "provider"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "enum": [
            "rest"
          ]
        },
        "provider": {
          "enum": [
            "open-meteo"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
