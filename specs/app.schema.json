{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutyva.invalid/specs/app.schema.json",
  "title": "MUTYVA MVP application definition",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "widgets", "dataSources", "permissions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{3,128}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 500},
    "widgets": {
      "type": "array", "maxItems": 100,
      "items": {"$ref": "#/$defs/widget"}
    },
    "dataSources": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/source"}},
    "permissions": {
      "type": "array", "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "maxLength": 128}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "widget": {
      "type": "object", "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{1,63}$"},
        "kind": {"enum": ["city-search", "weather-card", "forecast-list", "air-card", "humidity-card"]},
        "title": {"type": "string", "maxLength": 120}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object", "required": ["id", "kind", "provider"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "kind": {"enum": ["rest"]},
        "provider": {"enum": ["open-meteo"]}
      },
      "additionalProperties": false
    }
  }
}
