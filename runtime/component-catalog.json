{
  "version": 3,
  "layout": "parent-referenced-containers",
  "components": [
    {
      "kind": "city-search",
      "title": "Поиск города",
      "description": "Поиск города через Open-Meteo. defaultCity задаёт общий город при запуске и после применения изменения; без свойства используется Paris. Несколько поисков разделяют общий город, заданные defaultCity должны совпадать.",
      "source": "geocoding",
      "bindings": [
        {
          "path": "city.search",
          "type": "string",
          "access": "action-input"
        }
      ],
      "actions": [
        "searchCity"
      ],
      "permissions": [
        "network:*.open-meteo.com"
      ],
      "propertyNames": [
        "title",
        "defaultCity"
      ]
    },
    {
      "kind": "weather-card",
      "title": "Текущая погода",
      "description": "Температура и скорость ветра для выбранного города.",
      "source": "weather",
      "bindings": [
        {
          "path": "weather.current.temperature",
          "type": "number",
          "unit": "°C",
          "access": "read-only"
        },
        {
          "path": "weather.current.wind",
          "type": "number",
          "unit": "km/h",
          "access": "read-only"
        }
      ],
      "actions": [],
      "permissions": [
        "network:*.open-meteo.com"
      ],
      "propertyNames": [
        "title"
      ]
    },
    {
      "kind": "forecast-list",
      "title": "Прогноз на 7 дней",
      "description": "Список дат, минимальной и максимальной температуры и осадков.",
      "source": "weather",
      "bindings": [
        {
          "path": "weather.daily",
          "type": "array",
          "items": {
            "date": "string",
            "min": "number",
            "max": "number",
            "rain": "number"
          },
          "access": "read-only"
        }
      ],
      "actions": [],
      "permissions": [
        "network:*.open-meteo.com"
      ],
      "propertyNames": [
        "title"
      ]
    },
    {
      "kind": "air-card",
      "title": "Качество воздуха",
      "description": "European Air Quality Index выбранного города.",
      "source": "airQuality",
      "bindings": [
        {
          "path": "air.current.european_aqi",
          "type": "integer",
          "access": "read-only"
        }
      ],
      "actions": [],
      "permissions": [
        "network:*.open-meteo.com"
      ],
      "propertyNames": [
        "title"
      ]
    },
    {
      "kind": "humidity-card",
      "title": "Влажность воздуха",
      "description": "Относительная влажность из уже загружаемого прогноза. Отдельный API-запрос не нужен.",
      "source": "weather",
      "bindings": [
        {
          "path": "weather.current.humidity",
          "type": "integer",
          "unit": "%",
          "access": "read-only"
        }
      ],
      "actions": [],
      "permissions": [
        "network:*.open-meteo.com"
      ],
      "propertyNames": [
        "title"
      ]
    },
    {
      "kind": "text",
      "title": "Текст",
      "description": "Обычный текст без HTML и выражений.",
      "container": false,
      "bindings": [],
      "actions": [],
      "permissions": [],
      "propertyNames": [
        "title",
        "text",
        "style"
      ],
      "defaults": {
        "text": "Новый текст"
      }
    },
    {
      "kind": "card",
      "title": "Карточка",
      "description": "Контейнер с фоном и заголовком. Вложенные виджеты ссылаются на его ID через parent.",
      "container": true,
      "bindings": [],
      "actions": [],
      "permissions": [],
      "propertyNames": [
        "title",
        "style"
      ],
      "defaults": {}
    },
    {
      "kind": "stack",
      "title": "Колонка",
      "description": "Вертикальный контейнер вложенных компонентов.",
      "container": true,
      "bindings": [],
      "actions": [],
      "permissions": [],
      "propertyNames": [
        "title",
        "style"
      ],
      "defaults": {}
    },
    {
      "kind": "row",
      "title": "Строка",
      "description": "Горизонтальный контейнер; на узком экране элементы располагаются вертикально.",
      "container": true,
      "bindings": [],
      "actions": [],
      "permissions": [],
      "propertyNames": [
        "title",
        "style"
      ],
      "defaults": {}
    },
    {
      "kind": "button",
      "title": "Кнопка",
      "description": "Пользователь запускает разрешённое действие append-item или clear-list. Без action кнопка неактивна.",
      "container": false,
      "bindings": [],
      "actions": [
        "append-item",
        "clear-list"
      ],
      "permissions": [],
      "propertyNames": [
        "title",
        "action",
        "style"
      ],
      "defaults": {}
    },
    {
      "kind": "input",
      "title": "Поле ввода",
      "description": "Локальное текстовое значение в SQLite, до 500 символов.",
      "container": false,
      "bindings": [],
      "actions": [],
      "permissions": [],
      "propertyNames": [
        "title",
        "value",
        "placeholder"
      ],
      "defaults": {
        "value": "",
        "placeholder": "Введите текст"
      }
    },
    {
      "kind": "list",
      "title": "Список",
      "description": "Локальный список строк в SQLite, до 50 элементов.",
      "container": false,
      "bindings": [],
      "actions": [],
      "permissions": [],
      "propertyNames": [
        "title",
        "items"
      ],
      "defaults": {
        "items": []
      }
    },
    {
      "source": "",
      "bindings": [],
      "permissions": [],
      "container": false,
      "kind": "record-form",
      "title": "Форма записей",
      "description": "Создаёт и редактирует типизированные записи локальной модели. Данные хранятся отдельно от истории интерфейса.",
      "actions": [
        "create-record",
        "update-record"
      ],
      "propertyNames": [
        "title",
        "model",
        "style"
      ]
    },
    {
      "source": "",
      "bindings": [],
      "permissions": [],
      "container": false,
      "kind": "record-list",
      "title": "Список записей",
      "description": "Просмотр, выбор и удаление записей модели; необязательные типизированные filter и sort.",
      "actions": [
        "select-record",
        "delete-record"
      ],
      "propertyNames": [
        "title",
        "model",
        "filter",
        "sort",
        "style"
      ]
    },
    {
      "source": "",
      "bindings": [],
      "permissions": [],
      "container": false,
      "kind": "checkbox",
      "title": "Флажок",
      "description": "Логическое локальное значение true/false, хранится в SQLite.",
      "actions": [],
      "propertyNames": [
        "title",
        "value",
        "style"
      ],
      "defaults": {
        "value": "false"
      }
    },
    {
      "source": "",
      "bindings": [],
      "permissions": [],
      "container": false,
      "kind": "select",
      "title": "Выбор",
      "description": "Выбор одной строки из до 20 предопределённых вариантов.",
      "actions": [],
      "propertyNames": [
        "title",
        "value",
        "options",
        "style"
      ],
      "defaults": {
        "options": [
          "Первый",
          "Второй"
        ],
        "value": "Первый"
      }
    },
    {
      "source": "",
      "bindings": [],
      "permissions": [],
      "container": false,
      "kind": "date-picker",
      "title": "Дата",
      "description": "Локальное ISO-дата YYYY-MM-DD, редактируется с проверкой.",
      "actions": [],
      "propertyNames": [
        "title",
        "value",
        "style"
      ],
      "defaults": {
        "value": ""
      }
    },
    {
      "source": "",
      "bindings": [],
      "permissions": [],
      "container": false,
      "kind": "dialog",
      "title": "Диалог",
      "description": "Кнопка открывает доверенный Qt Quick Dialog с текстом; без произвольных обработчиков.",
      "actions": [
        "open-dialog"
      ],
      "propertyNames": [
        "title",
        "message",
        "style"
      ],
      "defaults": {
        "message": "Информация"
      }
    },
    {
      "source": "",
      "bindings": [],
      "permissions": [],
      "container": true,
      "kind": "tabs",
      "title": "Вкладки",
      "description": "Контейнер: каждый прямой ребёнок образует отдельную вкладку.",
      "actions": [],
      "propertyNames": [
        "title",
        "style"
      ],
      "defaults": {}
    },
    {
      "source": "",
      "bindings": [],
      "permissions": [],
      "container": false,
      "kind": "image",
      "title": "Изображение",
      "description": "Только встроенные ресурсы бренда. Произвольные URL и файловые пути запрещены.",
      "actions": [],
      "propertyNames": [
        "title",
        "source",
        "style"
      ],
      "defaults": {
        "source": "mutyva-symbol"
      }
    },
    {
      "source": "",
      "bindings": [],
      "permissions": [],
      "container": false,
      "kind": "icon",
      "title": "Иконка",
      "description": "Безопасный набор символов, не требует сторонних загрузок.",
      "actions": [],
      "propertyNames": [
        "title",
        "icon",
        "style"
      ],
      "defaults": {
        "icon": "star"
      }
    }
  ]
}
